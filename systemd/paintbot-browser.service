[Unit]
Description=Ordinary Chrome desktop and local WB price bridge
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=paintbot
Group=paintbot
WorkingDirectory=/opt/paintbot
Environment=HOME=/opt/paintbot
ExecStart=/usr/bin/xvfb-run -a -s "-screen 0 1280x1024x24" /opt/paintbot/.venv/bin/python -m paintbot.services.wb_desktop
Restart=on-failure
RestartSec=15
TimeoutStopSec=40
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/paintbot/var /opt/paintbot/.cache /opt/paintbot/.config /opt/paintbot/.pki

[Install]
WantedBy=multi-user.target
