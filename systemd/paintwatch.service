[Unit]
Description=PaintWatch Telegram price monitor
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=paintwatch
Group=paintwatch
WorkingDirectory=/opt/paintwatch
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PLAYWRIGHT_BROWSERS_PATH=/opt/paintwatch/data/browsers
ExecStartPre=/opt/paintwatch/.venv/bin/python -m paintwatch.cli init-db
ExecStart=/opt/paintwatch/.venv/bin/python -m paintwatch.main
Restart=on-failure
RestartSec=20
TimeoutStopSec=45
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/paintwatch/data /opt/paintwatch/logs

[Install]
WantedBy=multi-user.target
