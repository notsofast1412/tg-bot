[Unit]
Description=Restricted HTTPS CONNECT proxy inside Russian WireGuard
BindsTo=paintbot-ru-netns.service
After=paintbot-ru-netns.service

[Service]
Type=simple
User=paintbot
Group=paintbot
NetworkNamespacePath=/run/netns/paintbot-ru
BindReadOnlyPaths=/etc/netns/paintbot-ru/resolv.conf:/etc/resolv.conf
BindReadOnlyPaths=/etc/netns/paintbot-ru/nsswitch.conf:/etc/nsswitch.conf
InaccessiblePaths=-/run/nscd -/var/run/nscd
ExecStart=/usr/bin/python3 -I /usr/local/libexec/paintbot-ru-vpn.py proxy
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
LimitNOFILE=256
UMask=0077

[Install]
WantedBy=multi-user.target
