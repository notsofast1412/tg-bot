[Unit]
Description=Isolated WireGuard namespace for Paint Monitor Russian egress
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/python3 -I /usr/local/libexec/paintbot-ru-vpn.py start
ExecStop=/usr/bin/python3 -I /usr/local/libexec/paintbot-ru-vpn.py stop
RuntimeDirectory=paintbot-ru
RuntimeDirectoryMode=0700
TimeoutStartSec=60
TimeoutStopSec=30
NoNewPrivileges=true
CapabilityBoundingSet=CAP_NET_ADMIN CAP_SYS_ADMIN
# No private mount namespace: /run/netns must be visible to the proxy unit.

[Install]
WantedBy=multi-user.target
