# Токен от @BotFather; никогда не отправляйте его в чат/репозиторий.
BOT_TOKEN=
# Положительный Telegram user ID владельца. Управление только из его личного чата.
OWNER_ID=0
# Необязательно: можно настроить командой /setgroup в боте.
# NOTIFICATION_CHAT_ID=-1001234567890
DATA_DIR=data
LOG_DIR=logs
DISPLAY_TIMEZONE=Europe/Moscow
CHECK_INTERVAL=600
WB_INTERVAL=600
OZON_INTERVAL=600
REQUEST_GAP=3
REQUEST_TIMEOUT=20
SCENARIO_TIMEOUT=1800
MAX_BATCH=30
WB_DEST=-1257786
# Резервный рендеринг, не обход CAPTCHA/авторизации. Сначала установите Chromium.
BROWSER_ENABLED=false
# CHROMIUM_PATH=/usr/bin/chromium
